alias py="python3"
alias jb="jobs"

alias t="tmux new -A -s main"

alias clr="clear"
alias cls="clear"

alias ls='eza --icons'
alias ll='eza --icons -l'
alias lla='eza --icons -la'
alias la='eza --icons -a'
alias l='eza --icons'
alias llr='eza --icons -l --tree --level=2'
alias cat='bat --paging=never'
alias ee="eduvia-env"

alias ism="idea . & sm"

# $ FILE|URL…: open on this desktop, or, in a `2o ssh` shell, on the desktop
# it came from. Falls back to open/xdg-open where 2o is not installed.
"$"(){
    if (( $+commands[2o] )); then
        local t
        for t in "$@"; do 2o open "$t" || return; done
    elif [ "$(uname -s)" = Darwin ]; then
        open "$@"
    else
        xdg-open "$@"
    fi
}
alias x='$'

# ssh through 2o (tunnel back to this desktop); `command ssh` for plain ssh,
# e.g. modes 2o cannot wrap (-N -f -W -O…).
"ssh"(){
    if (( $+commands[2o] )); then
        2o ssh "$@"
    else
        command ssh "$@"
    fi
}

"sm"(){
    if [ "$(uname -s)" = Darwin ]; then
        open -a  /Applications/Sublime\ Merge.app $@
    else
        smerge $@ & disown
    fi
}

"killp"(){
    lsof -t -i:$@ | xargs kill
}

unalias rds
"rds"(){
  if [ "$#" -eq 0 ]; then
    rails db:seed
  elif [ "$#" -eq 1 ]; then
    rails db:seed:"$1"
  else
    echo "Usage: rds or rds foo"
    return 1
  fi
}
alias rdsd="rails db:schema:dump"

alias fm="foreman start"
alias fmo="OPEN=true foreman start"

alias calude="claude --dangerously-skip-permissions"
alias claude="claude --dangerously-skip-permissions"

alias wake-serv-2="wakeonlan 74:56:3c:37:95:15"

"eduvia-env"(){
  command ~/Documents/eduvia/tools/env/eduvia-env "$@"
  local ret=$?
  if [ -f "$HOME/.eduvia-env-cd" ]; then
    local target
    target=$(cat "$HOME/.eduvia-env-cd")
    rm -f "$HOME/.eduvia-env-cd"
    [ -d "$target" ] && cd "$target"
  fi
  return $ret
}
alias eel="eduvia-env list"
alias eed="eduvia-env destroy"
alias eec="eduvia-env create"
alias ees="eduvia-env start"

"batt"(){
    local cap=$(cat /sys/class/power_supply/BAT1/capacity 2>/dev/null)
    local bat_status=$(cat /sys/class/power_supply/BAT1/status 2>/dev/null)
    if [ -z "$cap" ]; then
        echo "No battery found"
        return 1
    fi
    local icon
    if [ "$bat_status" = "Charging" ] || [ "$bat_status" = "Full" ]; then
        icon="⚡"
    elif [ "$cap" -ge 80 ]; then icon="█████"
    elif [ "$cap" -ge 60 ]; then icon="████░"
    elif [ "$cap" -ge 40 ]; then icon="███░░"
    elif [ "$cap" -ge 20 ]; then icon="██░░░"
    else icon="█░░░░"
    fi
    echo "$icon $cap% ($bat_status)"
}
