# OS
.DS_Store

# Zed local data (conversations, prompts db, extensions cache)
zed/.config/zed/conversations/
zed/.config/zed/prompts/
zed/.config/zed/extensions/
zed/.config/zed/settings_backup.json

# Karabiner auto-backups
karabiner/.config/karabiner/automatic_backups/
karabiner/.config/karabiner/assets/

# Zsh generated files
zsh/.zcompdump*
zsh/.zsh_history

# Skill secrets never go in git — tokens live in Seafile (~/.secrets). *.env.example is OK.
claude/.claude/skills/**/*.env

# herdr runtime (logs, session state, release notes) — config.toml stays tracked
herdr/.config/herdr/*.log
herdr/.config/herdr/session.json
herdr/.config/herdr/release-notes.json

# bin: only hand-written scripts belong here — exclude compiled binaries
# (herdr ~13MB, omp ~157MB) and pip-installed fonttools entry-point wrappers.
bin/.local/bin/herdr
bin/.local/bin/omp
bin/.local/bin/fonttools
bin/.local/bin/ttx
bin/.local/bin/pyftsubset
bin/.local/bin/pyftmerge
